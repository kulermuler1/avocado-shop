@model Avocado_shop.Models.Product

@{
    ViewData["Title"] = Model.Name;
}

<div class="container">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Strona g³ówna</a></li>
            <li class="breadcrumb-item"><a asp-controller="Products" asp-action="Index">Produkty</a></li>
            @if (Model.Category != null)
            {
                <li class="breadcrumb-item">
                    <a asp-controller="Categories" asp-action="Products" asp-route-id="@Model.CategoryId">@Model.Category.Name</a>
                </li>
            }
            <li class="breadcrumb-item active">@Model.Name</li>
        </ol>
    </nav>

    <div class="row">
        <!-- Obrazek produktu -->
        <div class="col-lg-5 mb-4">
            <div class="card shadow-sm">
                <div class="card-body bg-light d-flex align-items-center justify-content-center" style="min-height: 350px;">
                    @if (!string.IsNullOrEmpty(Model.ImageUrl))
                    {
                        <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid" style="max-height: 320px; object-fit: contain;">
                    }
                    else
                    {
                        <div class="text-center text-muted">
                            <i class="bi bi-box display-1"></i>
                            <p class="mt-2">Brak zdjêcia</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Informacje o produkcie -->
        <div class="col-lg-7">
            <div class="mb-2">
                @if (Model.Category != null)
                {
                    <a asp-controller="Categories" asp-action="Products" asp-route-id="@Model.CategoryId" class="text-decoration-none">
                        <span class="badge bg-secondary">@Model.Category.Name</span>
                    </a>
                }
            </div>

            <h1 class="mb-3">@Model.Name</h1>

            <div class="mb-4">
                <span class="display-6 text-primary fw-bold">@Model.Price.ToString("N2") z³</span>
            </div>

            <!-- Dostêpnoœæ -->
            <div class="mb-4">
                @if (Model.Stock > 10)
                {
                    <span class="badge bg-success fs-6"><i class="bi bi-check-circle me-1"></i> Dostêpny</span>
                    <span class="text-muted ms-2">(@Model.Stock szt. w magazynie)</span>
                }
                else if (Model.Stock > 0)
                {
                    <span class="badge bg-warning text-dark fs-6"><i class="bi bi-exclamation-circle me-1"></i> Ostatnie sztuki</span>
                    <span class="text-muted ms-2">(zosta³o @Model.Stock szt.)</span>
                }
                else
                {
                    <span class="badge bg-danger fs-6"><i class="bi bi-x-circle me-1"></i> Niedostêpny</span>
                }
            </div>

            <!-- Dodaj do koszyka -->
            @if (Model.Stock > 0)
            {
                <div class="card mb-4">
                    <div class="card-body">
                        <form asp-controller="Cart" asp-action="Add" method="post">
                            <input type="hidden" name="productId" value="@Model.Id" />
                            <div class="row align-items-center">
                                <div class="col-auto">
                                    <label class="form-label mb-0">Iloœæ:</label>
                                </div>
                                <div class="col-auto">
                                    <input type="number" name="qty" value="1" min="1" max="@Model.Stock" class="form-control" style="width: 80px;">
                                </div>
                                <div class="col">
                                    <button type="submit" class="btn btn-primary btn-lg">
                                        <i class="bi bi-cart-plus me-2"></i>Dodaj do koszyka
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            }

            <!-- Opis -->
            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>Opis produktu</h5>
                </div>
                <div class="card-body">
                    <p class="mb-0">@Model.Description</p>
                </div>
            </div>

            <!-- Dodatkowe informacje -->
            <div class="row mt-4 text-center">
                <div class="col-4">
                    <i class="bi bi-truck text-primary fs-4"></i>
                    <p class="small text-muted mb-0">Darmowa dostawa<br>od 500 z³</p>
                </div>
                <div class="col-4">
                    <i class="bi bi-shield-check text-success fs-4"></i>
                    <p class="small text-muted mb-0">Gwarancja<br>24 miesi¹ce</p>
                </div>
                <div class="col-4">
                    <i class="bi bi-arrow-return-left text-warning fs-4"></i>
                    <p class="small text-muted mb-0">Zwrot<br>14 dni</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Powrót -->
    <div class="mt-4">
        <a asp-controller="Products" asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-2"></i>Powrót do produktów
        </a>
    </div>
</div>
