@model IEnumerable<Avocado_shop.Models.Product>

@{
    ViewData["Title"] = "Wszystkie produkty";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-box-seam me-2"></i>Wszystkie produkty</h1>
        <span class="badge bg-primary fs-6">@Model.Count() produktów</span>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            <i class="bi bi-info-circle me-2"></i>Brak produktów w sklepie.
        </div>
    }
    else
    {
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4">
            @foreach (var product in Model)
            {
                <div class="col">
                    <div class="card h-100 product-card shadow-sm">
                        <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height: 180px;">
                            @if (!string.IsNullOrEmpty(product.ImageUrl))
                            {
                                <img src="@product.ImageUrl" alt="@product.Name" class="img-fluid" style="max-height: 160px; object-fit: contain;">
                            }
                            else
                            {
                                <i class="bi bi-box text-muted display-4"></i>
                            }
                        </div>
                        <div class="card-body">
                            <p class="text-muted small mb-1">@product.Category?.Name</p>
                            <h6 class="card-title">@product.Name</h6>
                            <p class="card-text text-muted small">
                                @if (product.Description?.Length > 60)
                                {
                                    @(product.Description.Substring(0, 60))<text>...</text>
                                }
                                else
                                {
                                    @product.Description
                                }
                            </p>
                        </div>
                        <div class="card-footer bg-transparent">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="h5 text-primary mb-0 fw-bold">@product.Price.ToString("N2") z³</span>
                                @if (product.Stock > 0)
                                {
                                    <span class="badge bg-success">Dostêpny</span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">Brak</span>
                                }
                            </div>
                            <div class="d-grid gap-2">
                                <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-primary btn-sm">
                                    <i class="bi bi-eye me-1"></i> Szczegó³y
                                </a>
                                @if (product.Stock > 0)
                                {
                                    <form asp-controller="Cart" asp-action="Add" method="post">
                                        <input type="hidden" name="productId" value="@product.Id" />
                                        <input type="hidden" name="qty" value="1" />
                                        <button type="submit" class="btn btn-primary btn-sm w-100">
                                            <i class="bi bi-cart-plus me-1"></i> Do koszyka
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .product-card {
        transition: transform 0.2s, box-shadow 0.2s;
    }
    .product-card:hover {
        transform: translateY(-3px);
        box-shadow: 0 8px 25px rgba(0,0,0,0.12) !important;
    }
</style>
