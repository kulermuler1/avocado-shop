@model Avocado_shop.Models.Category

@{
    ViewData["Title"] = "Dodaj kategoriê";
}

<h1>Dodaj kategoriê</h1>

<div class="row">
    <div class="col-md-6">
        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="Name" class="form-label"></label>
                <input asp-for="Name" class="form-control" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Description" class="form-label"></label>
                <textarea asp-for="Description" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="ParentCategoryId" class="form-label">Kategoria nadrzêdna</label>
                <select asp-for="ParentCategoryId" asp-items="@(ViewData["ParentCategoryId"] as SelectList)" class="form-select">
                    <option value="">-- Brak (kategoria g³ówna) --</option>
                </select>
                <span asp-validation-for="ParentCategoryId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="IconClass" class="form-label">Klasa ikony Bootstrap</label>
                <input asp-for="IconClass" class="form-control" placeholder="np. bi-cpu, bi-mouse" />
                <small class="text-muted">Ikony: <a href="https://icons.getbootstrap.com/" target="_blank">Bootstrap Icons</a></small>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="MinPrice" class="form-label">Cena minimalna (opcjonalne)</label>
                    <input asp-for="MinPrice" class="form-control" type="number" step="0.01" />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="MaxPrice" class="form-label">Cena maksymalna (opcjonalne)</label>
                    <input asp-for="MaxPrice" class="form-control" type="number" step="0.01" />
                </div>
            </div>

            <button type="submit" class="btn btn-primary"><i class="bi bi-check me-1"></i>Zapisz</button>
            <a asp-action="Index" class="btn btn-secondary">Anuluj</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
