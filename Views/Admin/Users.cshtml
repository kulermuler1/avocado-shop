@model IEnumerable<Avocado_shop.Controllers.UserViewModel>

@{
    ViewData["Title"] = "U¿ytkownicy";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-people me-2"></i>U¿ytkownicy</h1>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Powrót do panelu
        </a>
    </div>

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <span class="badge bg-primary me-2">@Model.Count() u¿ytkowników</span>
            <span class="badge bg-danger">@Model.Count(u => u.Roles.Contains("Admin")) adminów</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Email / Login</th>
                            <th>Status email</th>
                            <th>Rola</th>
                            <th class="text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            <tr>
                                <td>
                                    <div class="d-flex align-items-center">
                                        <div class="bg-light rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 40px; height: 40px;">
                                            @if (user.Roles.Contains("Admin"))
                                            {
                                                <i class="bi bi-shield-lock text-danger"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-person text-primary"></i>
                                            }
                                        </div>
                                        <div>
                                            <strong>@user.Email</strong>
                                            <br>
                                            <small class="text-muted">ID: @user.Id.Substring(0, 8)...</small>
                                        </div>
                                    </div>
                                </td>
                                <td class="align-middle">
                                    @if (user.EmailConfirmed)
                                    {
                                        <span class="badge bg-success">
                                            <i class="bi bi-check-circle me-1"></i>Potwierdzony
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark">
                                            <i class="bi bi-exclamation-circle me-1"></i>Niepotwierdzony
                                        </span>
                                    }
                                </td>
                                <td class="align-middle">
                                    @foreach (var role in user.Roles)
                                    {
                                        @if (role == "Admin")
                                        {
                                            <span class="badge bg-danger">
                                                <i class="bi bi-shield-lock me-1"></i>@role
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">
                                                <i class="bi bi-person me-1"></i>@role
                                            </span>
                                        }
                                    }
                                    @if (!user.Roles.Any())
                                    {
                                        <span class="text-muted">Brak roli</span>
                                    }
                                </td>
                                <td class="text-end align-middle">
                                    @if (user.Email != "admin@local.test") @* Nie pozwól usun¹æ g³ównego admina *@
                                    {
                                        <form asp-action="ToggleAdminRole" method="post" class="d-inline">
                                            <input type="hidden" name="userId" value="@user.Id" />
                                            @if (user.Roles.Contains("Admin"))
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-warning" 
                                                        onclick="return confirm('Czy na pewno chcesz odebraæ uprawnienia administratora?')">
                                                    <i class="bi bi-shield-minus"></i> Odbierz admina
                                                </button>
                                            }
                                            else
                                            {
                                                <button type="submit" class="btn btn-sm btn-outline-success"
                                                        onclick="return confirm('Czy na pewno chcesz nadaæ uprawnienia administratora?')">
                                                    <i class="bi bi-shield-plus"></i> Nadaj admina
                                                </button>
                                            }
                                        </form>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">G³ówny admin</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Legenda -->
    <div class="card mt-4">
        <div class="card-body small">
            <h6>Legenda ról:</h6>
            <span class="badge bg-danger me-2"><i class="bi bi-shield-lock me-1"></i>Admin</span>
            - Pe³ny dostêp do panelu administracyjnego, zarz¹dzanie produktami, kategoriami, u¿ytkownikami i zamówieniami.
            <br>
            <span class="badge bg-secondary me-2"><i class="bi bi-person me-1"></i>User</span>
            - Standardowy u¿ytkownik, mo¿e przegl¹daæ produkty, sk³adaæ zamówienia i przegl¹daæ swoj¹ historiê.
        </div>
    </div>
</div>
