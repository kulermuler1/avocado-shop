@model Avocado_shop.Models.Product

@{
    ViewData["Title"] = "Szczegó³y produktu";
}

<h1>Szczegó³y</h1>

<div class="card mb-3" style="max-width: 900px;">
    <div class="row no-gutters">
        <div class="col-md-4">
            @if (!string.IsNullOrEmpty(Model.ImageUrl))
            {
                <img src="@(Model.ImageUrl.StartsWith("/") ? Model.ImageUrl : "/" + Model.ImageUrl)" class="card-img" alt="image" />
            }
            else
            {
                <div class="p-4 text-muted">Brak obrazu</div>
            }
        </div>
        <div class="col-md-8">
            <div class="card-body">
                <h4 class="card-title">@Model.Name</h4>
                <p class="card-text">@Model.Description</p>
                <p class="card-text"><strong>Cena:</strong> @string.Format("{0:C}", Model.Price)</p>
                <p class="card-text"><strong>Stan magazynowy:</strong> @Model.Stock</p>
                <p class="card-text"><strong>Kategoria:</strong> @Model?.Category?.Name</p>
                <p>
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edytuj</a>
                    <a asp-action="Index" class="btn btn-secondary">Powrót</a>
                </p>
            </div>
        </div>
    </div>
</div>