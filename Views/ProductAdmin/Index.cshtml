@model IEnumerable<Avocado_shop.Models.Product>

@{
    ViewData["Title"] = "Produkty - Panel Admina";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1><i class="bi bi-box-seam me-2"></i>Zarz¹dzanie produktami</h1>
        <div>
            <a asp-controller="Admin" asp-action="Index" class="btn btn-outline-secondary me-2">
                <i class="bi bi-arrow-left me-1"></i> Panel
            </a>
            <a asp-action="Create" class="btn btn-primary">
                <i class="bi bi-plus-lg me-1"></i> Dodaj produkt
            </a>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card shadow-sm">
        <div class="card-header bg-white">
            <span class="badge bg-primary">@Model.Count() produktów</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 60px;"></th>
                            <th>Nazwa</th>
                            <th>Kategoria</th>
                            <th class="text-end">Cena</th>
                            <th class="text-center">Stan</th>
                            <th class="text-end">Akcje</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    <div class="bg-light rounded d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                                        @if (!string.IsNullOrEmpty(item.ImageUrl))
                                        {
                                            <img src="@item.ImageUrl" alt="@item.Name" class="img-fluid" style="max-height: 45px; max-width: 45px; object-fit: contain;">
                                        }
                                        else
                                        {
                                            <i class="bi bi-box text-muted"></i>
                                        }
                                    </div>
                                </td>
                                <td class="align-middle">
                                    <strong>@item.Name</strong>
                                    <br>
                                    <small class="text-muted">ID: @item.Id</small>
                                </td>
                                <td class="align-middle">
                                    <span class="badge bg-secondary">@item.Category?.Name</span>
                                </td>
                                <td class="text-end align-middle">
                                    <strong class="text-primary">@item.Price.ToString("N2") z³</strong>
                                </td>
                                <td class="text-center align-middle">
                                    @if (item.Stock > 10)
                                    {
                                        <span class="badge bg-success">@item.Stock szt.</span>
                                    }
                                    else if (item.Stock > 0)
                                    {
                                        <span class="badge bg-warning text-dark">@item.Stock szt.</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Brak</span>
                                    }
                                </td>
                                <td class="text-end align-middle">
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-outline-primary" title="Edytuj">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-outline-danger" title="Usuñ">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
