@model Avocado_shop.Models.Product

@{
    ViewData["Title"] = "Edytuj produkt";
}

<div class="container">
    <h1 class="mb-4"><i class="bi bi-pencil me-2"></i>Edytuj produkt</h1>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Nazwa produktu *</label>
                            <input asp-for="Name" class="form-control" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Opis</label>
                            <textarea asp-for="Description" class="form-control" rows="4"></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Price" class="form-label">Cena (z³) *</label>
                                <input type="text" 
                                       name="Price" 
                                       id="Price"
                                       class="form-control" 
                                       value="@Model.Price.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)"
                                       placeholder="0.00" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                                <small class="text-muted">U¿yj kropki jako separatora (np. 199.99)</small>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Stock" class="form-label">Stan magazynowy *</label>
                                <input asp-for="Stock" class="form-control" type="number" min="0" />
                                <span asp-validation-for="Stock" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="CategoryId" class="form-label">Kategoria *</label>
                                <select asp-for="CategoryId"
                                        asp-items="@(ViewData["CategoryId"] as SelectList)"
                                        class="form-select"></select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Obecny obraz</label>
                            <div class="border rounded p-3 bg-light">
                                @if (!string.IsNullOrEmpty(Model.ImageUrl))
                                {
                                    <img src="@Model.ImageUrl" alt="@Model.Name" style="max-width: 200px; max-height: 150px;" class="img-fluid" />
                                }
                                else
                                {
                                    <div class="text-muted">
                                        <i class="bi bi-image me-2"></i>Brak obrazu
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImageUrl" class="form-label">URL obrazu</label>
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                            <small class="text-muted">Podaj link do zewnêtrznego obrazu (np. z Flaticon, Unsplash)</small>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Anuluj
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i> Zapisz zmiany
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-info-circle me-2"></i>Informacje
                </div>
                <div class="card-body small">
                    <p><strong>ID produktu:</strong> @Model.Id</p>
                    <p><strong>Aktualna cena:</strong> @Model.Price.ToString("N2") z³</p>
                    <p><strong>Stan magazynowy:</strong> @Model.Stock szt.</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('Price').addEventListener('input', function(e) {
            this.value = this.value.replace(',', '.');
        });
    </script>
}
