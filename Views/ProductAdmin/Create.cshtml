@model Avocado_shop.Models.Product

@{
    ViewData["Title"] = "Dodaj produkt";
}

<div class="container">
    <h1 class="mb-4"><i class="bi bi-plus-lg me-2"></i>Dodaj nowy produkt</h1>

    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label asp-for="Name" class="form-label">Nazwa produktu *</label>
                            <input asp-for="Name" class="form-control" placeholder="Nazwa produktu" />
                            <span asp-validation-for="Name" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Opis</label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Szczegó³owy opis produktu..."></textarea>
                            <span asp-validation-for="Description" class="text-danger"></span>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="Price" class="form-label">Cena (z³) *</label>
                                <input asp-for="Price" class="form-control" type="text" placeholder="0.00" />
                                <span asp-validation-for="Price" class="text-danger"></span>
                                <small class="text-muted">U¿yj kropki jako separatora (np. 199.99)</small>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="Stock" class="form-label">Stan magazynowy *</label>
                                <input asp-for="Stock" class="form-control" type="number" min="0" value="0" />
                                <span asp-validation-for="Stock" class="text-danger"></span>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label asp-for="CategoryId" class="form-label">Kategoria *</label>
                                <select asp-for="CategoryId"
                                        asp-items="@(ViewData["CategoryId"] as SelectList)"
                                        class="form-select">
                                    <option value="">-- Wybierz kategoriê --</option>
                                </select>
                                <span asp-validation-for="CategoryId" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ImageUrl" class="form-label">URL obrazu</label>
                            <input asp-for="ImageUrl" class="form-control" placeholder="https://..." />
                            <small class="text-muted">Podaj link do zewnêtrznego obrazu (np. z Flaticon, Unsplash)</small>
                        </div>

                        <hr />

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i> Anuluj
                            </a>
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i> Dodaj produkt
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <i class="bi bi-info-circle me-2"></i>Wskazówki
                </div>
                <div class="card-body small">
                    <p><strong>Nazwa:</strong> Powinna byæ unikalna i opisowa.</p>
                    <p><strong>Opis:</strong> Dodaj szczegó³owe informacje o produkcie.</p>
                    <p><strong>Cena:</strong> U¿yj kropki jako separatora dziesiêtnego (np. 1299.99).</p>
                    <p><strong>Kategoria:</strong> Wybierz odpowiedni¹ podkategoriê.</p>
                    <p class="mb-0"><strong>Obraz:</strong> Podaj URL obrazu (np. z Flaticon).</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('Price').addEventListener('input', function(e) {
            this.value = this.value.replace(',', '.');
        });
    </script>
}
