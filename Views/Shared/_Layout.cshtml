<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Avocado Shop</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Avocado-shop.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <!-- Top bar -->
        <div class="bg-dark text-white py-2 small d-none d-md-block">
            <div class="container d-flex justify-content-between">
                <span><i class="bi bi-telephone me-1"></i> +48 123 456 789</span>
                <span><i class="bi bi-envelope me-1"></i> kontakt@avocado-shop.pl</span>
            </div>
        </div>

        <!-- Main navbar -->
        <nav class="navbar navbar-expand-lg navbar-dark bg-primary shadow-sm">
            <div class="container">
                <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
                    <i class="bi bi-pc-display-horizontal me-2"></i>Avocado Shop
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNavbar">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="collapse navbar-collapse" id="mainNavbar">
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Index">
                                <i class="bi bi-house me-1"></i> Strona g³ówna
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Categories" asp-action="Index">
                                <i class="bi bi-grid me-1"></i> Kategorie
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Products" asp-action="Index">
                                <i class="bi bi-box-seam me-1"></i> Wszystkie produkty
                            </a>
                        </li>
                    </ul>
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Cart" asp-action="Index">
                                <i class="bi bi-cart3 me-1"></i> Koszyk
                            </a>
                        </li>
                        @if (User.Identity != null && User.Identity.IsAuthenticated)
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-controller="Orders" asp-action="Index">
                                    <i class="bi bi-bag-check me-1"></i> Zamówienia
                                </a>
                            </li>
                        }
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="adminDropdown" role="button" data-bs-toggle="dropdown">
                                    <i class="bi bi-shield-lock me-1"></i> Panel Admina
                                </a>
                                <ul class="dropdown-menu dropdown-menu-end">
                                    <li><h6 class="dropdown-header">Zarz¹dzanie</h6></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Index"><i class="bi bi-speedometer2 me-2"></i>Dashboard</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Users"><i class="bi bi-people me-2"></i>U¿ytkownicy</a></li>
                                    <li><a class="dropdown-item" asp-controller="Admin" asp-action="Orders"><i class="bi bi-bag me-2"></i>Zamówienia</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                    <li><a class="dropdown-item" asp-controller="ProductAdmin" asp-action="Index"><i class="bi bi-box me-2"></i>Produkty</a></li>
                                    <li><a class="dropdown-item" asp-controller="CategoryAdmin" asp-action="Index"><i class="bi bi-folder me-2"></i>Kategorie</a></li>
                                </ul>
                            </li>
                        }
                    </ul>
                    <partial name="_LoginPartial" />
                </div>
            </div>
        </nav>
    </header>

    <div class="container my-4">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="bg-dark py-4 mt-5">
        <div class="container">
            <div class="row">
                <div class="col-md-4 mb-3">
                    <h5 class="text-white"><i class="bi bi-pc-display-horizontal me-2"></i>Avocado Shop</h5>
                    <p class="text-light small">Jakoœæ i cena, jakiej nigdzie indziej nie znajdziesz.</p>
                </div>
                <div class="col-md-4 mb-3">
                    <h6 class="text-white">Kategorie</h6>
                    <ul class="list-unstyled small">
                        <li><a asp-controller="Categories" asp-action="Index" class="text-light text-decoration-none">Gotowe zestawy</a></li>
                        <li><a asp-controller="Categories" asp-action="Index" class="text-light text-decoration-none">Podzespo³y</a></li>
                        <li><a asp-controller="Categories" asp-action="Index" class="text-light text-decoration-none">Peryferia</a></li>
                        <li><a asp-controller="Categories" asp-action="Index" class="text-light text-decoration-none">Monitory</a></li>
                    </ul>
                </div>
                <div class="col-md-4 mb-3">
                    <h6 class="text-white">Kontakt</h6>
                    <ul class="list-unstyled small text-light">
                        <li><i class="bi bi-geo-alt me-2"></i>ul. Pawia 45, Kraków</li>
                        <li><i class="bi bi-telephone me-2"></i>+48 512 837 294</li>
                        <li><i class="bi bi-envelope me-2"></i>kontakt@avocado-shop.pl</li>
                    </ul>
                </div>
            </div>
            <hr class="my-3 border-secondary">
            <div class="row">
                <div class="col-md-6 text-center text-md-start">
                    <span class="small text-light">
                        &copy; @DateTime.Now.Year Avocado Shop
                    </span>
                </div>
                <div class="col-md-6 text-center text-md-end">
                    <span class="small text-light">
                        Ikony: <a href="https://www.flaticon.com/" target="_blank" class="text-info text-decoration-none">Flaticon</a>
                    </span>
                </div>
            </div>
        </div>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
