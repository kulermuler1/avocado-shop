@model Avocado_shop.Models.Order

@{
    ViewData["Title"] = $"Zamówienie #{Model.Id}";
}

<div class="container">
    <h1 class="mb-4"><i class="bi bi-bag-check me-2"></i>Zamówienie #@Model.Id</h1>

    <div class="row">
        <div class="col-lg-8">
            <!-- Status -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-success text-white">
                    <h5 class="mb-0"><i class="bi bi-check-circle me-2"></i>Status: @Model.Status</h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <p class="mb-1"><strong>Data zamówienia:</strong></p>
                            <p class="text-muted">@Model.OrderDate.ToString("dd.MM.yyyy, HH:mm")</p>
                        </div>
                        <div class="col-md-6">
                            <p class="mb-1"><strong>Numer zamówienia:</strong></p>
                            <p class="text-muted">#@Model.Id</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Produkty -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0"><i class="bi bi-box-seam me-2"></i>Produkty</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Produkt</th>
                                    <th class="text-center">Iloœæ</th>
                                    <th class="text-end">Cena</th>
                                    <th class="text-end">Suma</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Items != null)
                                {
                                    foreach (var item in Model.Items)
                                    {
                                        <tr>
                                            <td>
                                                <div class="d-flex align-items-center">
                                                    <div class="bg-light rounded d-flex align-items-center justify-content-center me-3" style="width: 50px; height: 50px;">
                                                        <i class="bi bi-box text-muted"></i>
                                                    </div>
                                                    <div>
                                                        <strong>@(item.Product?.Name ?? "Produkt usuniêty")</strong>
                                                    </div>
                                                </div>
                                            </td>
                                            <td class="text-center align-middle">@item.Quantity szt.</td>
                                            <td class="text-end align-middle">@item.Price.ToString("N2") z³</td>
                                            <td class="text-end align-middle fw-bold">@((item.Price * item.Quantity).ToString("N2")) z³</td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- Podsumowanie -->
        <div class="col-lg-4">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h5 class="mb-0"><i class="bi bi-receipt me-2"></i>Podsumowanie</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span>Produkty</span>
                        <span>@Model.TotalPrice.ToString("N2") z³</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span>Dostawa</span>
                        <span class="text-success">Gratis</span>
                    </div>
                    <hr>
                    <div class="d-flex justify-content-between">
                        <span class="h5 mb-0">Razem</span>
                        <span class="h5 mb-0 text-primary fw-bold">@Model.TotalPrice.ToString("N2") z³</span>
                    </div>
                </div>
            </div>

            <div class="alert alert-success mt-3">
                <i class="bi bi-check-circle me-2"></i>
                <strong>Dziêkujemy za zamówienie!</strong>
            </div>
        </div>
    </div>

    <div class="mt-4">
        <a asp-action="Index" class="btn btn-outline-primary">
            <i class="bi bi-arrow-left me-2"></i>Moje zamówienia
        </a>
        <a asp-controller="Products" asp-action="Index" class="btn btn-primary">
            <i class="bi bi-box-seam me-2"></i>Kontynuuj zakupy
        </a>
    </div>
</div>
