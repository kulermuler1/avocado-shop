@model IEnumerable<Avocado_shop.Models.Order>

@{
    ViewData["Title"] = "Moje zamówienia";
}

<div class="container">
    <h1 class="mb-4"><i class="bi bi-bag-check me-2"></i>Moje zamówienia</h1>

    @if (!Model.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-bag-x display-1 text-muted mb-3"></i>
                <h4 class="text-muted">Nie masz jeszcze ¿adnych zamówieñ</h4>
                <p class="text-muted">Przegl¹daj produkty i z³ó¿ swoje pierwsze zamówienie.</p>
                <a asp-controller="Products" asp-action="Index" class="btn btn-primary btn-lg mt-3">
                    <i class="bi bi-box-seam me-2"></i>Przegl¹daj produkty
                </a>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Nr zamówienia</th>
                                <th>Data</th>
                                <th>Status</th>
                                <th class="text-end">Suma</th>
                                <th class="text-end"></th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var order in Model)
                            {
                                <tr>
                                    <td class="align-middle">
                                        <strong>#@order.Id</strong>
                                    </td>
                                    <td class="align-middle">
                                        @order.OrderDate.ToString("dd.MM.yyyy, HH:mm")
                                    </td>
                                    <td class="align-middle">
                                        @if (order.Status == "Nowe")
                                        {
                                            <span class="badge bg-primary">@order.Status</span>
                                        }
                                        else if (order.Status == "W realizacji")
                                        {
                                            <span class="badge bg-warning text-dark">@order.Status</span>
                                        }
                                        else if (order.Status == "Wys³ane")
                                        {
                                            <span class="badge bg-info">@order.Status</span>
                                        }
                                        else if (order.Status == "Dostarczone")
                                        {
                                            <span class="badge bg-success">@order.Status</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary">@order.Status</span>
                                        }
                                    </td>
                                    <td class="text-end align-middle">
                                        <strong class="text-primary">@order.TotalPrice.ToString("N2") z³</strong>
                                    </td>
                                    <td class="text-end align-middle">
                                        <a asp-action="Details" asp-route-id="@order.Id" class="btn btn-sm btn-outline-primary">
                                            <i class="bi bi-eye me-1"></i>Szczegó³y
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="mt-4">
            <a asp-controller="Products" asp-action="Index" class="btn btn-primary">
                <i class="bi bi-box-seam me-2"></i>Kontynuuj zakupy
            </a>
        </div>
    }
</div>
